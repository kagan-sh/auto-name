{
  "id": "dev.kagan.auto-name",
  "name": "Auto Name",
  "version": "0.4.0",
  "kagan": ">=0.1.0",
  "entry": "main.js",
  "instructions": "Names a thread once, from its prompt, changed paths, events, branch, and project. Deterministic, no model. Kagan keeps a title after the first name, so a thread with a title is left alone. Use Update thread names now to rescan.",
  "powers": {
    "areas": ["threads", "database"]
  },
  "settings": {
    "enabled": {
      "type": "boolean",
      "title": "Rename threads automatically",
      "default": true
    },
    "intervalSec": {
      "type": "select",
      "title": "Wait at least this many seconds between checks",
      "options": ["15", "30", "45", "60", "120"],
      "default": "45"
    },
    "maxWords": {
      "type": "select",
      "title": "Max words in a thread name",
      "options": ["2", "3", "4"],
      "default": "4"
    }
  },
  "commands": [
    {
      "id": "refresh",
      "title": "Update thread names now",
      "when": "always"
    },
    {
      "id": "where-enabled",
      "title": "Show where to turn renaming on or off",
      "when": "always"
    }
  ],
  "ui": {
    "panels": [
      {
        "id": "status",
        "title": "Auto Name",
        "view": "StatusPanel",
        "placement": "left"
      }
    ]
  },
  "events": [
    "thread.waiting",
    "thread.idle",
    "thread.turn.ended",
    "thread.file.changed",
    "thread.started",
    "thread.answered",
    "thread.notice"
  ],
  "tools": [],
  "skills": []
}
